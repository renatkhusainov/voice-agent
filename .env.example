# Database (local run; docker compose builds its own DATABASE_URL from POSTGRES_*)
DATABASE_URL=postgresql+psycopg://fde:fde@localhost:5432/fde_db
POSTGRES_USER=fde
POSTGRES_PASSWORD=fde
POSTGRES_DB=fde_db

# Twilio
TWILIO_NUMBER=+10000000000
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token

# Deepgram (speech-to-text)
DEEPGRAM_API_KEY=your-deepgram-api-key

# Anthropic (LLM)
ANTHROPIC_API_KEY=your-anthropic-api-key

# Redis (DialogState persistence — app/agent/store.py). For a local run
# (uvicorn on the host, Redis from `docker compose up -d redis`). Inside
# Docker, docker-compose.yaml sets redis://redis:6379/0 for the app itself.
REDIS_URL=redis://localhost:6379/0

# Gates dev-only endpoints (currently just GET /agent/sessions/{id}).
# Defaults to "production" (disabled) if unset — set explicitly to
# "development" for local work, same as this file's own values are for.
ENVIRONMENT=development

# "Speak while working" on a live call (app/agent/live.py): say a short filler
# line if a tool is still running after this many ms. Flip ENABLED for the
# A/B in docs/notes/filler-ab.md.
# TOOL_FILLER_ENABLED=true
# TOOL_FILLER_DELAY_MS=300

# Latency (docs/notes/latency-budget.md). LATENCY_LABEL tags call_metrics rows
# so runs can be compared; the rest are the knobs measured there.
# LATENCY_LABEL=default
# TTS_FLUSH_EACH_SENTENCE=true
# LLM_PROMPT_CACHING=false
# STT_TTFS_P99_SECS=0.35   # Pipecat's Deepgram default when unset

# MCP server (docs/mcp.md). stdio: the practice this local server acts for.
# HTTP: API-key hashes -> practice; generate with
#   python -m app.mcp_server new-key --practice-id 4
# MCP_PRACTICE_ID=4
# MCP_API_KEYS='{"<sha256 of key>": 4}'
# MCP_ALLOWED_HOSTS='["your-subdomain.ngrok.app"]'

# FHIR (docs/notes/fhir-cheatsheet.md): HAPI from docker compose. Default is
# the host port; the app container uses http://hapi:8080/fhir.
# FHIR_BASE_URL=http://localhost:8090/fhir
# HAPI's own database credentials (local dev defaults: hapi / hapi)
# HAPI_DB_USER=hapi
# HAPI_DB_PASSWORD=hapi

# Knowledge base embeddings (app/rag/embed.py, docs/notes/rag.md): an API key
# from dash.voyageai.com. Without it, /rag/search falls back to keyword-only.
# VOYAGE_API_KEY=
# EMBED_MODEL=voyage-4-lite
